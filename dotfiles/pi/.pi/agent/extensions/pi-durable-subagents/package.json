{
  "name": "pi-durable-subagents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test --test-concurrency=1 --test-timeout=30000 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:live": "node --experimental-strip-types test/live.ts",
    "lint": "oxlint src test scripts --deny-warnings",
    "lint:fix": "npm run lint -- --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.0",
    "@earendil-works/pi-durable": "1.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@oxlint/plugins": "1.86.0",
    "@types/node": "26.0.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typebox": "1.3.27",
    "typescript": "6.0.2"
  },
  "overrides": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/chord": "1.0.0",
    "typebox": "1.3.27"
  }
}
