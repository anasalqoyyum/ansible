# Reload configuration
# alt - o               : skhd --restart-service
# alt + shift - o       : yabai --restart-service

alt - q                 : yabai -m window --close
alt - m                 : yabai -m window --minimize

# Focus windows
alt + shift - h         : yabai -m window --focus west
alt + shift - j         : yabai -m window --focus south
alt + shift - k         : yabai -m window --focus north
alt + shift - l         : yabai -m window --focus east
alt + shift - 0x21      : yabai -m window --focus prev # 0x21 is [
alt + shift - 0x1E      : yabai -m window --focus next # 0x1E is ]

# Move windows
ctrl + alt - left       : yabai -m window --warp west
ctrl + alt - down       : yabai -m window --warp south
ctrl + alt - up         : yabai -m window --warp north
ctrl + alt - right      : yabai -m window --warp east
ctrl + alt - return     : yabai -m window --swap first
alt + shift - return    : yabai -m window --swap first

# Stack windows
ctrl + alt + shift - left    : yabai -m window --stack west
ctrl + alt + shift - down    : yabai -m window --stack south
ctrl + alt + shift - up      : yabai -m window --stack north
ctrl + alt + shift - right   : yabai -m window --stack east
# No clean yabai equivalent for komorebic unstack (0x29 is ;)
alt - 0x21                   : yabai -m window --focus stack.prev # 0x21 is [
alt - 0x1E                   : yabai -m window --focus stack.next # 0x1E is ]

# Resize (fall back to the opposite edge when the window touches the screen edge)
alt - 0x18              : yabai -m window --resize right:50:0  || yabai -m window --resize left:-50:0  # 0x18 is +
alt - 0x1B              : yabai -m window --resize right:-50:0 || yabai -m window --resize left:50:0   # 0x1B is -
alt + shift - 0x18      : yabai -m window --resize bottom:0:50  || yabai -m window --resize top:0:-50
alt + shift - 0x1B      : yabai -m window --resize bottom:0:-50 || yabai -m window --resize top:0:50

# Manipulate windows
alt + shift - t         : yabai -m window --toggle float
alt + shift - f         : yabai -m window --toggle zoom-fullscreen

# Window manager options
alt + shift - r         : yabai -m space --balance

# Layouts
alt + shift - x         : yabai -m space --mirror x-axis
alt + shift - y         : yabai -m space --mirror y-axis

# Previous Space bindings using the yabai focus helper
# alt - 1               : "$HOME/.config/yabai/focus-space" 1
# alt - 2               : "$HOME/.config/yabai/focus-space" 2
# alt - 3               : "$HOME/.config/yabai/focus-space" 3
# alt - 4               : "$HOME/.config/yabai/focus-space" 4
# alt - 5               : "$HOME/.config/yabai/focus-space" 5
# alt - 6               : "$HOME/.config/yabai/focus-space" 6
# alt - 7               : "$HOME/.config/yabai/focus-space" 7
# alt - 8               : "$HOME/.config/yabai/focus-space" 8

# Spaces
alt - 1                 : "$HOME/.local/bin/iss-cli" index 1
alt - 2                 : "$HOME/.local/bin/iss-cli" index 2
alt - 3                 : "$HOME/.local/bin/iss-cli" index 3
alt - 4                 : "$HOME/.local/bin/iss-cli" index 4
alt - 5                 : "$HOME/.local/bin/iss-cli" index 5
alt - 6                 : "$HOME/.local/bin/iss-cli" index 6
alt - 7                 : "$HOME/.local/bin/iss-cli" index 7
alt - 8                 : "$HOME/.local/bin/iss-cli" index 8

# Send focused window to space, without following it
alt + shift - 1         : yabai -m window --space 1
alt + shift - 2         : yabai -m window --space 2
alt + shift - 3         : yabai -m window --space 3
alt + shift - 4         : yabai -m window --space 4
alt + shift - 5         : yabai -m window --space 5
alt + shift - 6         : yabai -m window --space 6
alt + shift - 7         : yabai -m window --space 7
alt + shift - 8         : yabai -m window --space 8
