#!/usr/bin/env zsh

# Dotfiles installer with auto-discovery, logging, and error handling.
# Usage: DOTFILES=~/.dotfiles ./install [--verbose] [--dry-run]

set -u
set -o pipefail

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
LOG_FILE="$DOTFILES/.stow.log"
DRY_RUN=false
VERBOSE=false

print_usage() {
  cat <<'EOF'
Usage: ./install [--dry-run] [--verbose] [--help]
Environment:
  DOTFILES      Dotfiles directory (default: ~/.dotfiles)
  STOW_FOLDERS  Comma-separated folder list (default: auto-discover)
EOF
}

log_header() {
  {
    echo "=== Stow run: $(date '+%Y-%m-%d %H:%M:%S') ==="
    echo "Dotfiles location: $DOTFILES"
    echo "Dry run: $DRY_RUN"
    echo ""
  } >> "$LOG_FILE"
}

# Parse arguments.
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --verbose)
      VERBOSE=true
      shift
      ;;
    --help|-h)
      print_usage
      exit 0
      ;;
    *)
      echo "❌ Unknown argument: $1" >&2
      print_usage >&2
      exit 2
      ;;
  esac
done

if [[ ! -d "$DOTFILES" ]]; then
  echo "❌ Dotfiles directory not found: $DOTFILES" >&2
  exit 1
fi

if ! command -v stow >/dev/null 2>&1; then
  echo "❌ Required command not found: stow" >&2
  exit 1
fi

touch "$LOG_FILE" 2>/dev/null || {
  echo "❌ Cannot write log file: $LOG_FILE" >&2
  exit 1
}

log_header

echo "📦 Starting dotfiles installation..."
echo "   Location: $DOTFILES"

cd "$DOTFILES" || {
  echo "❌ Failed to enter directory: $DOTFILES" >&2
  exit 1
}

echo "🧹 Checking for .DS_Store files..."
ds_store_count=$(find . -name ".DS_Store" -type f | wc -l | tr -d ' ')
if [[ "$DRY_RUN" == true ]]; then
  echo "   Dry run: would remove $ds_store_count file(s)"
else
  if [[ "$ds_store_count" -gt 0 ]]; then
    find . -name ".DS_Store" -type f -delete
  fi
  echo "   Removed $ds_store_count file(s)"
fi

# Resolve folders: use STOW_FOLDERS if set, otherwise auto-discover package directories.
typeset -a folders
if [[ -n "${STOW_FOLDERS:-}" ]]; then
  folders=(${(@s:,:)STOW_FOLDERS})
else
  folders=(${(f)"$(find . -mindepth 1 -maxdepth 1 -type d \
    -not -name '.*' \
    -not -name '__pycache__' \
    -exec basename {} \; | sort)"})
fi

if [[ ${#folders[@]} -eq 0 ]]; then
  echo "❌ No dotfile folders found in $DOTFILES"
  exit 1
fi

echo "📂 Folders: ${folders[*]}"
echo ""

# Linked whole so tools that replace files inside them write into the dotfiles.
typeset -a directory_links=(agents/.agents/skills)

typeset -a stow_cmd
stow_cmd=(stow -R --no-folding --ignore='(^|/)node_modules$')
for entry in "${directory_links[@]}"; do
  stow_cmd+=("--ignore=^${${entry#*/}//./\\.}")
done
if [[ "$DRY_RUN" == true ]]; then
  stow_cmd+=(-n)
fi
if [[ "$VERBOSE" == true ]]; then
  stow_cmd+=(-v)
fi

link_directory() {
  local package=$1 relative=$2
  local staged="$PWD/$package/$relative"
  local target="${PWD:h}/$relative"
  local up="" part
  for part in ${(s:/:)relative:h}; do
    up+="../"
  done
  local link="$up${PWD:t}/$package/$relative"

  if [[ -L "$target" ]]; then
    [[ "$(readlink "$target")" == "$link" ]] && return 0
    echo "❌ $target links to $(readlink "$target"), expected $link" >&2
    return 1
  fi

  if [[ -e "$target" ]]; then
    local -a unmanaged
    local entry counterpart
    for entry in "$target"/**/*(DN^/); do
      counterpart="$staged/${entry#$target/}"
      if [[ -L "$entry" ]]; then
        [[ "${entry:A}" == "${counterpart:A}" ]] || unmanaged+=("$entry")
      elif ! cmp -s "$entry" "$counterpart"; then
        unmanaged+=("$entry")
      fi
    done
    if [[ ${#unmanaged[@]} -gt 0 ]]; then
      echo "❌ $target has ${#unmanaged[@]} file(s) missing from or different in $staged:" >&2
      printf "   • %s\n" "${unmanaged[@]:0:10}" >&2
      echo "   Merge them into $staged, then remove $target and rerun." >&2
      return 1
    fi
  fi

  if [[ "$DRY_RUN" == true ]]; then
    echo "Would link $target -> $link"
    return 0
  fi
  rm -rf "$target"
  mkdir -p "${target:h}"
  ln -s "$link" "$target"
  echo "Linked $target -> $link"
}

link_directories() {
  local folder=$1 entry
  for entry in "${directory_links[@]}"; do
    if [[ "${entry%%/*}" == "$folder" ]]; then
      link_directory "$folder" "${entry#*/}" || return 1
    fi
  done
}

# Track outcomes.
typeset -a failed_folders skipped_folders
success_count=0

for folder in "${folders[@]}"; do
  if [[ -z "$folder" ]]; then
    continue
  fi

  if [[ ! -d "$folder" ]]; then
    echo "⚠️  Skipping $folder (directory not found)"
    skipped_folders+=("$folder")
    continue
  fi

  echo -n "🔗 Stowing $folder... "

  tmp_log=$(mktemp)
  if "${stow_cmd[@]}" "$folder" >"$tmp_log" 2>&1 \
      && link_directories "$folder" >>"$tmp_log"; then
    cat "$tmp_log" >> "$LOG_FILE"
    rm -f "$tmp_log"
    echo "✓"
    ((success_count++))
  else
    cat "$tmp_log" >> "$LOG_FILE"
    rm -f "$tmp_log"
    echo "✗ FAILED"
    failed_folders+=("$folder")
    {
      echo ""
      echo "ERROR stowing $folder at $(date '+%Y-%m-%d %H:%M:%S')"
      echo ""
    } >> "$LOG_FILE"
  fi
done

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if [[ ${#skipped_folders[@]} -gt 0 ]]; then
  echo "⚠️  Skipped folders:"
  printf "   • %s\n" "${skipped_folders[@]}"
fi

# Summary.
if [[ ${#failed_folders[@]} -eq 0 ]]; then
  echo "✅ All $success_count folders stowed successfully"
  {
    echo "✅ Completed successfully at $(date '+%Y-%m-%d %H:%M:%S')"
    echo ""
  } >> "$LOG_FILE"
  exit 0
fi

echo "❌ Stowing completed with errors:"
printf "   • %s\n" "${failed_folders[@]}"
echo ""
echo "   Check log: $LOG_FILE"
{
  echo "❌ Failed with ${#failed_folders[@]} folder(s) at $(date '+%Y-%m-%d %H:%M:%S')"
  echo "Failed folders: ${failed_folders[*]}"
  echo ""
} >> "$LOG_FILE"
exit 1
