// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)]
//
// Installed Extensions:
// - HTML
// - SQL
// - Astro
// - OXC
// - tsgo
// - toml
// - Tokyo Night Dark Theme
// - Material Icon
//
// Installed Agents:
// - Claude
// - Codex
// - Pi
// - Copilot CLI + Chat (need to also check bottom-right Copilot for inline suggestions)
{
  "terminal": {
    "shell": "system"
  },
  "language_models": {
    "opencode": {
      "show_go_models": false,
      "show_zen_models": false
    },
    "deepseek": {
      "api_url": "https://api.deepseek.com/v1",
      "available_models": [
        {
          "name": "deepseek-v4-flash-vision-exp",
          "display_name": "DeepSeek V4 Flash Vision (Experimental)",
          "max_tokens": 1000000,
          "max_output_tokens": 384000
        }
      ]
    }
  },
  "icon_theme": "Material Icon Theme",
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "agent": {
    "use_modifier_to_send": true,
    "default_profile": "full",
    "show_turn_stats": true,
    "play_sound_when_agent_done": "when_hidden",
    "profiles": {
      "full": {
        "default_model": {
          "provider": "openai-subscribed",
          "model": "gpt-5.6-sol",
          "enable_thinking": true,
          "effort": "low"
        },
        "name": "Full",
        "tools": {
          "write_file": true,
          "terminal": true,
          "spawn_agent": true,
          "skill": true,
          "read_file": true,
          "move_path": true,
          "list_directory": true,
          "grep": true,
          "find_path": true,
          "fetch": true,
          "edit_file": true,
          "diagnostics": true,
          "delete_path": true,
          "create_directory": true,
          "copy_path": true,
          "ask_user": true
        },
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "sandbox_permissions": {
      "allow_fs_write_all": true,
      "allow_all_hosts": true
    },
    "tool_permissions": {
      "default": "allow",
      "tools": {}
    },
    "default_model": {
      "effort": "max",
      "provider": "openai-subscribed",
      "model": "gpt-5.6-luna",
      "enable_thinking": true
    },
    "dock": "left",
    "favorite_models": [
      {
        "provider": "openrouter",
        "model": "z-ai/glm-5.3-flash",
        "enable_thinking": true
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-sol",
        "enable_thinking": true,
        "effort": "low"
      },
      {
        "provider": "deepseek",
        "model": "deepseek-v4-flash-vision-exp",
        "enable_thinking": true
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-luna",
        "enable_thinking": true,
        "effort": "max"
      }
    ],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "right"
  },
  "preferred_line_length": 80,
  "soft_wrap": "editor_width",
  "use_smartcase_search": true,
  "vim": {
    "use_smartcase_find": true,
    "gdefault": true,
    "toggle_relative_line_numbers": true
  },
  "prettier": {
    "allowed": true
  },
  "auto_signature_help": true,
  "vim_mode": false,
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "zed"
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "mode": "full-access"
      },
      "type": "registry"
    }
  },
  "project_panel": {
    "dock": "right"
  },
  "which_key": {
    "enabled": true
  },
  "session": {
    "trust_all_worktrees": true
  },
  "base_keymap": "VSCode",
  "preview_tabs": {
    "enabled": false
  },
  "tab_bar": {
    "show": false
  },
  "sticky_scroll": {
    "enabled": true
  },
  "minimap": {
    "show": "never"
  },
  "buffer_font_fallbacks": [
    "GeistMono Nerd Font",
    "JetBrainsMono Nerd Font",
    "Consolas",
    ".ZedMono"
  ],
  "buffer_font_family": "GoogleSansCode Nerd Font",
  "colorize_brackets": true,
  "show_edit_predictions": true,
  "ui_font_size": 16,
  "buffer_font_size": 15.0,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Tokyo Night Dark"
  },
  "lsp": {
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": null,
          "run": "onType",
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": null,
          "run": "onSave"
        }
      }
    }
  },
  "languages": {
    "CSS": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "GraphQL": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "Handlebars": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "HTML": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JavaScript": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        },
        {
          "code_action": "source.fixAll.oxc"
        }
      ]
    },
    "JSON": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSON5": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSONC": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "Less": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "Markdown": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "MDX": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "SCSS": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "TypeScript": {
      "format_on_save": "on",
      // "language_servers": ["tsgo", "!vtsls", "!typescript-language-server", "!eslint", "..."],
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "TSX": {
      "format_on_save": "on",
      // "language_servers": ["tsgo", "!vtsls", "!typescript-language-server", "!eslint", "..."],
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "Vue.js": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "YAML": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    }
  }
}
