#!/bin/sh
set -eu
umask 077

geometry=$(slurp) || exit 0
[ -n "$geometry" ] || exit 0

directory="$(xdg-user-dir PICTURES)/Screenshots"
mkdir -p "$directory"
file=$(mktemp "$directory/Screenshot-area-$(date +%Y-%m-%d_%H-%M-%S)-XXXXXX.png")

if ! grim -g "$geometry" "$file"; then
    rm -f "$file"
    exit 1
fi

wl-copy --type image/png < "$file"
